# Copie ce fichier en .env et remplis les valeurs. Ne le publie jamais.

# google (API Gemini / Gemma) ou groq
LLM_PROVIDER=google

GEMINI_API_KEY=colle-ta-cle-google-ici
GEMMA_MODEL=gemma-4-26b-a4b-it

GROQ_API_KEY=colle-ta-cle-groq-ici
GROQ_MODEL=gemma2-9b-it

# Supabase : clé publishable uniquement côté navigateur (RLS activé).
SUPABASE_URL=https://ton-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=colle-ta-cle-publishable-ici
